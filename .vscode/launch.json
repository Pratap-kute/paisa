{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Paisa: Debug Backend (Go)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/backend",
      "args": ["serve"],
      "env": {
        "CGO_ENABLED": "1"
      }
    },
    {
      "name": "Paisa: Run Full Dev (Deno)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "deno",
      "runtimeArgs": [
        "run",
        "--allow-env",
        "--allow-read",
        "--allow-run",
        "--allow-write",
        "--allow-net=0.0.0.0:7500,0.0.0.0:5173",
        "scripts/dev.ts",
        "--frontend"
      ],
      "cwd": "${workspaceFolder}",
      "outputCapture": "std"
    }
  ]
}
