{
  "name": "paisa-frontend",
  "version": "0.9.3",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "preview": "vite preview",
    "build": "svelte-kit sync && vite build",
    "build:watch": "vite build --watch",
    "clean": "bun run scripts/clean.ts",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "audit": "bun audit --ignore GHSA-gcqx-w48m-w2h4",
    "check": "bun run architecture && bun run ui:spec-check && bun run typecheck",
    "check:tooling": "bun run scripts/check.ts --tooling",
    "architecture": "bun test scripts/check_architecture_test.ts && bun run scripts/check_architecture.ts",
    "ui:spec-check": "bun test scripts/check_ui_spec_test.ts && bun run scripts/check_ui_spec.ts",
    "typecheck": "bun run scripts/check.ts",
    "parser-build": "lezer-generator src/lib/features/sheets/language.grammar -o src/lib/generated/sheet/parser && lezer-generator src/lib/features/editor/query.grammar -o src/lib/generated/search/parser",
    "parser-build-debug": "lezer-generator src/lib/features/sheets/language.grammar --names -o src/lib/generated/sheet/parser && lezer-generator src/lib/features/editor/query.grammar --names -o src/lib/generated/search/parser",
    "api:generate": "bun run scripts/generate_api.ts",
    "api:check": "bun run scripts/generate_api.ts --check",
    "test": "bun run test:unit && bun run test:core && bun run test:component",
    "test:unit": "bun test --path-ignore-patterns='**/*.component.test.ts' src/",
    "test:core": "vitest run --config vitest.config.ts --project=core --pool=threads --maxWorkers=1 --no-isolate",
    "test:component": "vitest run --config vitest.config.ts --project=component --maxWorkers=1",
    "test:integration": "bun test tests/regression.test.ts",
    "test:coverage": "bun run scripts/coverage.ts",
    "test:coverage:report": "bun run scripts/coverage.ts --report-only",
    "test:desktop": "bun run scripts/desktop_smoke.ts",
    "test:e2e": "bun run scripts/run_browser_tests.ts --grep-invert @visual",
    "test:visual": "bun run scripts/run_browser_tests.ts --grep @visual",
    "test:visual:update": "bun run scripts/run_browser_tests.ts --grep @visual --update-snapshots",
    "test:frontend": "bun run test:unit && bun run test:e2e && bun run test:visual && bun run test:coverage",
    "playwright": "playwright"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@datasert/cronjs-matcher": "^1.4.0",
    "@datasert/cronjs-parser": "^1.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@iconify/json": "^2.2.554",
    "@lezer/common": "^1.5.5",
    "@lezer/generator": "^1.8.1",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.12",
    "@playwright/test": "1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "arima": "^0.2.8",
    "bignumber.js": "^11.1.5",
    "bits-ui": "^2.20.6",
    "dayjs": "^1.11.23",
    "devalue": "^6.0.3",
    "echarts": "^6.1.0",
    "es-toolkit": "^1.53.2",
    "handlebars": "^4.7.10",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.5.438",
    "set-cookie-parser": "^3.2.2",
    "svelte-check": "^4.7.8",
    "svelte-dnd-action": "^0.9.80",
    "svelte-select": "^6.0.0",
    "svelte-tiny-virtual-list": "^4.0.0",
    "swagger-typescript-api": "13.13.0",
    "tabulator-tables": "^6.7.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "xlsx-populate": "^1.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@happy-dom/global-registrator": "^21.0.4",
    "@iconify/tools": "^5.0.14",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@types/bun": "^1.4.4",
    "happy-dom": "^21.0.4",
    "svelte": "^5.57.3",
    "svgtofont": "^6.5.3",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "rolldown"
  ],
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
