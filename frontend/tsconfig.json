{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun",
      "./src/app.d.ts",
      "$app/types"
    ],
    "paths": {
      "#lib": [
        "./src/lib"
      ],
      "#lib/*": [
        "./src/lib/*"
      ],
      "xlsx": [
        "./src/lib/shared/vendor/xlsx.mjs"
      ]
    },
    "strict": false,
    "checkJs": false
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.svelte",
    "vite.config.js"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "tests/**/*.ts"
  ]
}
