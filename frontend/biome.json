{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules/**",
      "!**/.svelte-kit/**",
      "!**/build/**",
      "!**/dist/**",
      "!**/coverage/**",
      "!**/*.svelte",
      "!**/tests/fixture/**",
      "!**/tests/fixtures/**",
      "!**/src/lib/api/generated/**",
      "!**/src/lib/generated/**",
      "!**/src/lib/shared/vendor/**",
      "!**/graphify-out/**"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "preset": "recommended"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
