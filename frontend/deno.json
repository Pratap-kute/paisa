{
  "tasks": {
    "dev": "deno run -A npm:vite dev --host 0.0.0.0",
    "preview": "deno run -A npm:vite preview",

    "build": "deno run -A --unsafe-proto npm:@sveltejs/kit sync && deno run -A --unsafe-proto npm:vite build",
    "build:watch": "deno run -A npm:vite build --watch",

    "audit": "deno audit",
    "check": "deno task typecheck",
    "check:tooling": "deno run -A scripts/check.ts --tooling",
    "format": "deno fmt",
    "lint": "deno lint",
    "typecheck": "deno run -A scripts/check.ts",

    "parser-build": "deno run -A npm:@lezer/generator src/lib/sheet/language.grammar -o src/lib/sheet/parser && deno run -A npm:@lezer/generator src/lib/search/parser/query.grammar -o src/lib/search/parser/parser",
    "parser-build-debug": "deno run -A npm:@lezer/generator src/lib/sheet/language.grammar --names -o src/lib/sheet/parser && deno run -A npm:@lezer/generator src/lib/search/parser/query.grammar --names -o src/lib/search/parser/parser",

    "test": "deno task test:unit && deno task test:integration",
    "test:core": "deno run -A npm:vitest@2.1.9 run --config vitest.core.config.ts --pool=threads --maxWorkers=1 --minWorkers=1",
    "test:component": "deno run -A npm:vitest@2.1.9 run --config vitest.config.ts --pool=threads --maxWorkers=1 --minWorkers=1",
    "test:coverage": "deno run -A scripts/coverage.ts",
    "test:coverage:report": "deno run -A scripts/coverage.ts --report-only",
    "test:desktop": "deno run --allow-env --allow-read --allow-run --allow-write scripts/desktop_smoke.ts",
    "test:e2e": "deno run -A scripts/run_browser_tests.ts --grep-invert @visual",
    "test:frontend": "deno task test:unit && deno task test:component && deno task test:e2e && deno task test:visual && deno task test:coverage",
    "test:integration": "deno test --no-check --allow-all --ignore=tests/core tests/",
    "test:unit": "deno test --no-check --allow-read --allow-env --ignore=src/lib/components src/",
    "test:visual": "deno run -A scripts/run_browser_tests.ts --grep @visual",
    "test:visual:update": "deno run -A scripts/run_browser_tests.ts --grep @visual --update-snapshots",

    "clean": "rm -rf .svelte-kit ../backend/web/static coverage playwright-report test-results"
  },
  "imports": {
    "$lib": "./src/lib",
    "@cityssm/bulma-sticky-table": "npm:@cityssm/bulma-sticky-table@^2.1.0",
    "@codemirror/autocomplete": "npm:@codemirror/autocomplete@^6.4.2",
    "@codemirror/commands": "npm:@codemirror/commands@^6.3.3",
    "@codemirror/language": "npm:@codemirror/language@^6.10.0",
    "@codemirror/lint": "npm:@codemirror/lint@^6.5.0",
    "@codemirror/merge": "npm:@codemirror/merge@^6.1.1",
    "@codemirror/search": "npm:@codemirror/search@^6.5.5",
    "@codemirror/state": "npm:@codemirror/state@^6.4.0",
    "@codemirror/view": "npm:@codemirror/view@^6.23.0",
    "@datasert/cronjs-matcher": "npm:@datasert/cronjs-matcher@^1.2.0",
    "@datasert/cronjs-parser": "npm:@datasert/cronjs-parser@^1.2.0",
    "@egjs/svelte-grid": "npm:@egjs/svelte-grid@^1.14.2",
    "@fontsource-variable/roboto-flex": "npm:@fontsource-variable/roboto-flex@^5.0.8",
    "@fontsource-variable/roboto-mono": "npm:@fontsource-variable/roboto-mono@^5.0.9",
    "@fortawesome/fontawesome-free": "npm:@fortawesome/fontawesome-free@^6.0",
    "@happy-dom/global-registrator": "npm:@happy-dom/global-registrator@^17.4.6",
    "@iconify/json": "npm:@iconify/json@^2.2.124",
    "@iconify/tools": "npm:@iconify/tools@^3.0.5",
    "@lezer/common": "npm:@lezer/common@^1.2.0",
    "@lezer/generator": "npm:@lezer/generator@^1.5.0",
    "@lezer/highlight": "npm:@lezer/highlight@^1.1.6",
    "@lezer/lr": "npm:@lezer/lr@^1.3.10",
    "@playwright/test": "npm:@playwright/test@1.61.1",
    "@std/expect": "jsr:@std/expect@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/testing/bdd": "jsr:@std/testing@^1/bdd",
    "json-schema": "npm:@types/json-schema@^7.0.15",
    "@sveltejs/adapter-static": "npm:@sveltejs/adapter-static@^3.0.0",
    "@sveltejs/kit": "npm:@sveltejs/kit@2.5.0",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^3.0.0",
    "@testing-library/jest-dom": "npm:@testing-library/jest-dom@6.9.1",
    "@testing-library/svelte": "npm:@testing-library/svelte@^4.2.3",
    "@vitest/coverage-v8": "npm:@vitest/coverage-v8@2.1.9",
    "arima": "npm:arima@^0.2.5",
    "bignumber.js": "npm:bignumber.js@^9.1.2",
    "bulma": "npm:bulma@^0.9.4",
    "chroma-js": "npm:chroma-js@^2.4.2",
    "chrono-node": "npm:chrono-node@^2.6.6",
    "codemirror": "npm:codemirror@^6.0.1",
    "cookie": "npm:cookie@^0.6.0",
    "crypto-js": "npm:crypto-js@^4.2.0",
    "d3": "npm:d3@^7.4.0",
    "d3-path-arrows": "npm:d3-path-arrows@^0.4.0",
    "d3-sankey-circular": "npm:d3-sankey-circular@^0.34.0",
    "dayjs": "npm:dayjs@^1.11.0",
    "devalue": "npm:devalue@^4.3.2",
    "financial": "npm:financial@^0.1.3",
    "handlebars": "npm:handlebars@^4.7.7",
    "lodash": "npm:lodash@^4.17.21",
    "oslllo-svg-fixer": "npm:oslllo-svg-fixer@^3.0.0",
    "papaparse": "npm:papaparse@^5.4.1",
    "pdfjs-dist": "npm:pdfjs-dist@^3.10.111",
    "pdfjs-dist/build/pdf.worker.js?url": "npm:pdfjs-dist@^3.10.111/build/pdf.worker.js",
    "sass": "npm:sass@1.77.6",
    "set-cookie-parser": "npm:set-cookie-parser@^2.6.0",
    "stemmer": "npm:stemmer@^2.0.1",
    "svelte": "npm:svelte@^4.2.7",
    "svelte-carousel": "npm:svelte-carousel@^1.0.25",
    "svelte-check": "npm:svelte-check@^3.6.0",
    "svelte-dnd-action": "npm:svelte-dnd-action@^0.9.37",
    "svelte-select": "npm:svelte-select@^5.8.0",
    "svelte-tiny-virtual-list": "npm:svelte-tiny-virtual-list@^2.0.5",
    "svgtofont": "npm:svgtofont@^4.0.0",
    "tabulator-tables": "npm:tabulator-tables@^6.3.1",
    "textures": "npm:textures@^1.2.3",
    "tippy.js": "npm:tippy.js@^6.3.7",
    "typescript": "npm:typescript@^5.0.0",
    "vite": "npm:vite@^5.0.3",
    "vite-plugin-node-polyfills": "npm:vite-plugin-node-polyfills@0.22.0",
    "vitest": "npm:vitest@2.1.9",
    "xlsx": "npm:xlsx@0.18.5",
    "xlsx-populate": "npm:xlsx-populate@^1.21.0"
  },
  "compilerOptions": {
    "checkJs": false,
    "skipLibCheck": true,
    "noImplicitAny": true
  },
  "fmt": {
    "exclude": [
      ".svelte-kit/",
      "../backend/web/static/",
      "graphify-out/",
      "src/lib/search/parser/parser.js",
      "src/lib/sheet/parser.js",
      "tests/fixture/"
    ]
  },
  "lint": {
    "rules": {
      "exclude": ["no-sloppy-imports"]
    },
    "exclude": [
      ".svelte-kit/",
      "../backend/web/static/",
      "graphify-out/",
      "src/lib/search/parser/parser.js",
      "src/lib/sheet/parser.js",
      "tests/fixture/"
    ]
  },
  "unstable": ["sloppy-imports"],
  "nodeModulesDir": "auto"
}
