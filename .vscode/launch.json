{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Paisa: Debug Backend (Go)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/backend",
      "args": ["serve"],
      "env": {
        "CGO_ENABLED": "1"
      }
    },
    {
      "name": "Paisa: Run Full Dev (Bun)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "scripts/dev.ts",
        "--frontend"
      ],
      "cwd": "${workspaceFolder}",
      "outputCapture": "std"
    }
  ]
}
